<div id="roleManager">
  <h2>Danh sách nhóm quyền</h2>
  <button id="addRoleBtn">Thêm Quyền</button>

  <table>
    <thead>
      <tr>
        <th>ID Nhóm quyền</th>
        <th>Tên nhóm quyền</th>
        <th>Trạng thái</th>
        <th>Thao tác</th>
      </tr>
    </thead>
    <tbody>
      {{#each roles}}
        <tr>
          <td>{{this.ID_NhomQuyen}}</td>
          <td>{{this.TenNhomQuyen}}</td>
          <td>Hoạt động</td>
          <td>
            <button class="editRoleBtn" data-id="{{ID_NhomQuyen}}" data-name="{{TenNhomQuyen}}">Sửa</button>
            <button class="deleteRoleBtn" data-id="{{ID_NhomQuyen}}">Xóa</button>
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>

<!-- Modal Thêm nhóm quyền -->
<div id="addRoleModal" class="modal">
  <div class="modal-content">
    <span class="close" id="closeAddRoleModal">&times;</span>

    <div class="form-group">
      <label for="newRoleName">Tên nhóm quyền:</label>
      <input type="text" id="newRoleName" placeholder="Nhập tên nhóm quyền..." />
    </div>

    <table>
      <thead>
        <tr>
          <th>Chức năng</th>
          <th>Xem</th>
          <th>Tạo mới</th>
          <th>Cập nhật</th>
          <th>Xóa</th>
        </tr>
      </thead>
      <tbody id="permissionTableBody">
        <!-- Dòng chức năng sẽ được thêm bằng JS -->
      </tbody>
    </table>

    <div class="form-actions" style="margin-top: 20px;">
      <button id="submitAddRoleBtn">Thêm nhóm quyền</button>
      <button id="cancelAddRoleBtn" class="cancel-btn">Hủy bỏ</button>
    </div>
  </div>
</div>

<!-- Modal Xóa nhóm quyền -->
<div id="deleteRoleModal" class="modal">
  <div class="modal-content">
    <p>Bạn có chắc chắn muốn xóa nhóm quyền này?</p>
    <div class="form-actions">
      <button id="confirmDeleteRoleBtn">Xóa</button>
      <button id="cancelDeleteRoleBtn">Hủy</button>
    </div>
  </div>
</div>

