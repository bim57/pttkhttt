<h2>Danh sách người dùng</h2>
<button id="addUserBtn">Thêm người dùng</button>
<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Tên người dùng</th>
      <th>Nhóm quyền</th>
      <th>Thao tác</th>
    </tr>
  </thead>
  <tbody>
    {{#each users}}
    <tr>
      <td>{{this.ID_TK}}</td>
      <td>{{this.TenNhanVien}}</td>
      <td>{{this.TenQuyen}}</td>
      <td>
        <button class="editBtn" data-id="{{ID_TK}}">Sửa</button>
        <button class="deleteBtn" data-id="{{ID_TK}}">Xóa</button>
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>

<!-- Modal Thêm/Sửa người dùng -->
<div id="userModal" class="modal">
  <div class="modal-content">
    <span class="close">&times;</span>
    <h2 id="modalTitle">Thêm người dùng</h2>
    <form id="userForm" class="modal-form">
      <input type="hidden" id="userId" />

      <!-- Nhập tên nhân viên -->
      <div class="form-group">
        <label for="userNhanVien">Tên nhân viên:</label>
        <input type="text" id="userNhanVien" name="TenNhanVien" required placeholder="Nhập tên nhân viên">
      </div>

      <!-- Chọn nhóm quyền -->
      <div class="form-group">
        <label for="userRole">Chọn quyền:</label>
        <select id="userRole" required>
          <option value="" disabled selected>-- Chọn quyền --</option>
          {{#each roles}}  <!-- Giả sử bạn đã có danh sách quyền -->
            <option value="{{this.ID_NhomQuyen}}">{{this.TenQuyen}}</option>
          {{/each}}
        </select>
      </div>

      <!-- Mật khẩu -->
      <div class="form-group">
        <label for="userPassword">Mật khẩu:</label>
        <input type="password" id="userPassword" placeholder="Nhập mật khẩu..." required />
      </div>

      <div class="form-actions">
        <button type="submit" class="save-btn">Thêm</button>
        <button type="button" class="cancel-btn" id="cancelModalBtn">Hủy</button>
      </div>
    </form>
  </div>
</div>


<!-- Modal Xóa người dùng -->
<div id="deleteModal" class="modal">
  <div class="modal-content">
    <p>Bạn có chắc chắn muốn xóa người dùng này?</p>
    <div class="form-actions">
      <button id="confirmDeleteBtn">Xóa</button>
      <button id="cancelDeleteBtn">Hủy</button>
    </div>
  </div>
</div>
