{{#block "css"}}
    <link rel="stylesheet" href="/css/provider.css">
{{/block}}

{{#block "js"}}
    <script src="/js/provider.js"></script>
{{/block}}

<!-- Provider table -->
<div class="provider-table">
    <div class="inside-table">
        <div class="providerHeader">
            <h2>Nhà Cung Cấp</h2>
            <div>
                <a href="/provider/create"><button class="add-provider">Thêm Nhà Cung Cấp</button></a>
            </div>
        </div>
        <div>
            <form action="/provider/search" method="get" id="search-form">
                <div class="search-container">
                    <input type="text" name="search" id="search" 
                    placeholder="Nhập thông tin cần tìm kiếm ..." autocomplete="off">
                    <button class="search-btn"><i class="fas fa-search"></i></button>
                </div>
            </form>
        </div>
        <table id="provider_table">
            <thead>
                <tr id="header-row">
                    <td class="sortable">ID<span class="arrow">▲</span></td>
                    <td class="sortable">Tên<span class="arrow">▲</span></td>
                    <td class="sortable">SĐT<span class="arrow">▲</span></td>
                    <td class="sortable">Email<span class="arrow">▲</span></td>
                    <td class="sortable">Số nhà, Đường<span class="arrow">▲</span></td>
                    <td class="sortable">Quận, Huyện<span class="arrow">▲</span></td>
                    <td class="sortable">Tỉnh, Thành phố<span class="arrow">▲</span></td>
                    <td>Hoạt động</td>
                </tr>
            </thead>
            <tbody class="providers-list">
                {{#if provider.length}}
                {{#each provider}}
                    <tr>
                        <td>{{this.ID_NCC}}</td>
                        <td>{{this.TenNCC}}</td>
                        <td>{{this.SDT}}</td>
                        <td>{{this.Email}}</td>
                        <td>{{this.SoNhaDuong}}</td>
                        <td>{{this.QuanHuyen}}</td>
                        <td>{{this.TinhThanhPho}}</td>
                        <td>
                            <div class="button-container">
                                <a href="/provider/update/{{this.ID_NCC}}">
                                    <button class="icon-btn edit-btn">
                                        <i class="fas fa-edit"></i>
                                        <span class="tooltip">Chỉnh sửa</span>
                                    </button>
                                </a>
                                <a href="/provider/delete/{{this.ID_NCC}}">
                                    <button class="icon-btn delete-btn">
                                        <i class="fas fa-trash-alt"></i>
                                        <span class="tooltip">Xóa</span>
                                    </button>
                                </a>
                            </div>
                        </td>
                    </tr>
                {{/each}}
                {{else}}
                    <tr>
                        <td colspan="7" style="text-align: center;">Không có dữ liệu</td>
                    </tr>
                {{/if}}
            </tbody>
        </table>
    </div>
</div>