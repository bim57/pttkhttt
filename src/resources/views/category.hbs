{{#block "css"}}
    <link rel="stylesheet" href="/css/category.css">
{{/block}}

{{#block "js"}}
    {{!-- <script src="/js/category.js"></script> --}}
{{/block}}

<!-- Category table -->
<div class="category-table">
    <div class="inside-table">
        <div class="categoryHeader">
            <h2>Danh Mục</h2>
            <div>
                <a href="/category/create"><button class="add-category">Thêm Danh Mục</button></a>
            </div>
        </div>
        <table>
            <thead>
                <tr>
                    <td>ID danh mục</td>
                    <td>Tên danh mục</td>
                    <td>Hoạt động</td>
                </tr>
            </thead>
            <tbody class="category-list">
                {{#each category}}
                    <tr>
                        <td>{{this.DanhMucID}}</td>
                        <td>{{this.TenDanhMuc}}</td>
                        <td>
                            <div class="button-container">
                                <a href="/category/view/{{this.DanhMucID}}">
                                    <button class="icon-btn view-btn">
                                        <i class="fas fa-eye"></i>
                                        <span class="tooltip">Chi tiết</span>
                                    </button>
                                </a>
                                <a href="/category/update/{{this.DanhMucID}}">
                                    <button class="icon-btn edit-btn">
                                        <i class="fas fa-edit"></i>
                                        <span class="tooltip">Chỉnh sửa</span>
                                    </button>
                                </a>
                                <a href="/category/delete/{{this.DanhMucID}}">
                                    <button class="icon-btn delete-btn">
                                        <i class="fas fa-trash-alt"></i>
                                        <span class="tooltip">Xóa</span>
                                    </button>
                                </a>
                            </div>
                        </td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
        
    </div>
</div>