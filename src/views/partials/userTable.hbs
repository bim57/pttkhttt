<h2>Danh sách người dùng</h2>
<button id="addUserBtn">Thêm người dùng</button>
<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Tên nhân viên</th>
      <th>Nhóm quyền</th>
      <th>Thao tác</th>
    </tr>
  </thead>
  <tbody>
    {{#each users}}
      <tr>
        <td>{{ID_TK}}</td>
        <td>{{TenNhanVien}}</td>
        <td>{{TenNhomQuyen}}</td>
        <td>
          <button class="editBtn" data-id="{{ID_TK}}">Sửa</button>
          <button class="deleteBtn" data-id="{{ID_TK}}">Xóa</button>
        </td>
      </tr>
    {{/each}}
  </tbody>
</table>