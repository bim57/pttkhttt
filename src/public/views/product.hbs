{{#block "css"}}
    <link rel="stylesheet" href="/css/product.css">
{{/block}}

{{#block "js"}}
    {{!-- <script src="/js/product.js"></script> --}}
{{/block}}

<!-- Product table -->
<div class="product-table">
    <div class="inside-table">
        <div class="productHeader">
            <h2>Danh Sách Sản Phẩm</h2>
            <div>
                <a href="/product/create"><button class="add-product">Thêm Sản Phẩm</button></a>
            </div>
        </div>
        <table>
            <thead>
                <tr>
                    <td>ID</td>
                    <td>Tên</td>
                    <td>Tác giả</td>
                    <td>Nhà xuất bản</td>
                    <td>Hình ảnh</td>
                    <td>Giá(VND)</td>
                    <td>SL tồn</td>
                    <td>Số trang</td>
                    <td>Mô tả</td>
                    <td>Hoạt động</td>
                </tr>
            </thead>
            <tbody class="products-list">
                {{#each product}}
                    <tr>
                        <td>{{this.SanPhamID}}</td>
                        <td>{{this.TenSanPham}}</td>
                        <td>{{this.TenTacGia}}</td>
                        <td>{{this.TenNXB}}</td>
                        <td><img src="{{this.Anh}}" width="100"></td>
                        <td>{{formatCurrency this.Gia}}</td>
                        <td>{{this.SoLuongTon}}</td>
                        <td>{{this.SoTrang}}</td>
                        <td>
                            <div class="mo-ta">
                                {{this.MoTa}}
                            </div>
                        </td>
                        <td>
                            <button class="edit-btn"><i class="fas fa-edit"></i></button>
                            <button class="delete-btn"><i class="fas fa-trash-alt"></i></button>
                        </td>
                    </tr>
                {{/each}}
            </tbody>
        </table>


        
    </div>
</div>