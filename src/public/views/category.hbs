{{#block "css"}}
    <link rel="stylesheet" href="/css/category.css">
{{/block}}

{{#block "js"}}
    {{!-- <script src="/js/category.js"></script> --}}
{{/block}}

<!-- Category table -->
<div class="category-table">
    <div class="inside-table">
        <div class="categoryHeader">
            <h2>Danh Sách Danh Mục</h2>
            <div>
                <a href="/category/create"><button class="add-category">Thêm Danh Mục</button></a>
            </div>
        </div>
        <table>
            <thead>
                <tr>
                    <td>ID danh mục</td>
                    <td>Tên danh mục</td>
                    <td>Hoạt động</td>
                </tr>
            </thead>
            <tbody class="category-list">
                {{#each category}}
                    <tr>
                        <td>{{this.DanhMucID}}</td>
                        <td>{{this.TenDanhMuc}}</td>
                        <td>
                            <a href="/category/view/{{this.DanhMucID}}"><button class="view-btn"><i class="fas fa-eye"></i></button></a>
                            <a href="/category/edit/{{this.DanhMucID}}"><button class="edit-btn"><i class="fas fa-edit"></i></button></a>
                            <a href="/category/delete/{{this.DanhMucID}}"><button class="delete-btn"><i class="fas fa-trash-alt"></i></button></a>
                        </td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
        
    </div>
</div>