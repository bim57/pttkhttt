{{#block "css"}}
    <link rel="stylesheet" href="/css/receipt.css">
{{/block}}

{{#block "js"}}
    <script src="/js/receipt.js"></script>
{{/block}}

<div class="receipt-table">
    <div class="inside-table">
        <div class="receiptHeader">
            <h2>Thêm Nhà Hóa Đơn Mới</h2>
            <a href="/receipt"><button class="cancel-btn">Quay lại</button></a>
        </div>

        <form method="post" action="/receipt/store">
            <div class="form-group">
                <label for="provider" class="form-label">Nhà Cung Cấp</label>
                <input type="text" class="form-control" id="provider" name="provider" 
                placeholder="Nhập id hoặc tên nhà cung cấp ..." required>
                <div id="suggestions_provider"></div>
            </div>
            <div class="form-group">
                <label for="employee" class="form-label">Nhân Viên</label>
                <input type="text" class="form-control" id="employee" name="employee" 
                placeholder="Nhập id hoặc tên nhân viên ..." required>
                <div id="suggestions_employee"></div>
            </div>
            <div class="form-group">
                <label for="product" class="form-label">Sản Phẩm</label>
                <input type="text" class="form-control" id="product" name="product" 
                placeholder="Nhập id hoặc tên sản phẩm ..." required>
                <div id="suggestions_product"></div>
                <table border="1" id="product-list">
                    <thead>
                        <tr>
                            <th>Tên sản phẩm</th>
                            <th>Số lượng</th>
                            <th>Giá nhập</th>
                            <th>Xóa</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <button class="add-btn" type="submit">Thêm</button>
        </form>

    </div>
</div>